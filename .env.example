# ==============================================================================
# GistMyMail — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the project root:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# IMPORTANT:
# - NEVER commit your actual `.env` file containing secrets to version control.
# - In development, default fallback values allow the app to boot immediately
#   in In-Memory / Mock mode with zero external dependencies.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Application URLs
# ------------------------------------------------------------------------------
# Runtime environment: "development" | "production" | "test"
NODE_ENV=development

# Port on which the Fastify backend API listens
PORT=3000

# Web frontend application origin (used for CORS and OAuth redirects)
APP_BASE_URL=http://localhost:5173

# Backend API public origin (used to construct OAuth callbacks)
API_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & Session Secrets (CRITICAL)
# ------------------------------------------------------------------------------
# Random secret string for signing Fastify session cookies (minimum 32 characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=gistmymail_dev_session_secret_32bytes_min_length!!

# 32-byte (64-character hex) key for AES-256-GCM encryption of OAuth refresh tokens at rest
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 3. Database Persistence (PostgreSQL)
# ------------------------------------------------------------------------------
# If left empty, GistMyMail automatically boots in resilient In-Memory mode.
# Compatible with Neon, Supabase, AWS RDS, or local PostgreSQL:
# Example: postgres://username:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/gistmymail?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 4. Google Cloud OAuth 2.0 Credentials (Gmail API)
# ------------------------------------------------------------------------------
# Obtain from https://console.cloud.google.com -> APIs & Services -> Credentials
# Required Scopes:
#   - openid, email, profile
#   - https://www.googleapis.com/auth/gmail.readonly (reading email messages)
#   - https://www.googleapis.com/auth/gmail.send (sending scheduled digest emails)
#
# Authorized Redirect URI in Google Cloud Console MUST match:
#   http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ------------------------------------------------------------------------------
# 5. AI Inference Provider & Model Configuration
# ------------------------------------------------------------------------------
# Select provider:
#   "mock"       -> Deterministic offline test mode (zero network calls, instant)
#   "openrouter" -> Cloud LLM inference via OpenRouter API
#   "ollama"     -> 100% private local inference on your machine
AI_PROVIDER=mock

# Model ID:
#   For OpenRouter free tier: "google/gemma-4-31b-it:free" or "nvidia/nemotron-3.5-lightning:free"
#   For Ollama local:        "llama3.2:3b" or "qwen3:1.7b"
AI_MODEL=google/gemma-4-31b-it:free

# OpenRouter API Key (Required when AI_PROVIDER=openrouter)
# Obtain from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama Base URL (Required when AI_PROVIDER=ollama)
# Default local endpoint: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 6. Automated Digest Scheduler & Delivery Preferences
# ------------------------------------------------------------------------------
# Enable or disable the 60-second background delivery daemon
SCHEDULER_ENABLED=true

# Default timezone for scheduled daily digest delivery (e.g., "Asia/Kolkata", "UTC", "America/New_York")
DEFAULT_TIMEZONE=Asia/Kolkata

# Default daily dispatch time in 24-hour HH:mm format (e.g., "08:00")
DEFAULT_DELIVERY_TIME=08:00
