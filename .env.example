# GistMyMail Environment Configuration
# Copy this file to .env and provide your values

# Application Environment
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
PORT=3000

# Security (Required in production)
SESSION_SECRET=replace_with_32_byte_random_string_for_session_encryption
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_or_base64_encryption_key

# Database
# If left empty, GistMyMail starts in resilient In-Memory/Dev mode
# Compatible with Neon, Supabase, or local PostgreSQL:
# postgres://user:password@host:5432/gistmymail?sslmode=require
DATABASE_URL=

# Google OAuth 2.0 Credentials (Get from console.cloud.google.com)
# Scopes requested: openid, email, profile, https://www.googleapis.com/auth/gmail.readonly
# Send scope (https://www.googleapis.com/auth/gmail.send) requested when delivery is enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# AI Provider Configuration
# Options: "mock" (default, deterministic offline test/demo), "openrouter", "ollama"
AI_PROVIDER=mock
AI_MODEL=llama3.2:3b

# OpenRouter (Required if AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# Ollama local endpoint (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Scheduler & Delivery
SCHEDULER_ENABLED=true
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_DELIVERY_TIME=08:00
